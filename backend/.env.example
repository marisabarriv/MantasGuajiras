# =========================================================
# Plantilla de variables del backend.
# Copia este archivo como backend/.env y pon tus valores.
# backend/.env NUNCA se sube a git ni se comparte en ZIP.
# Formato: CLAVE=valor (sin comillas, sin espacios alrededor de =)
# =========================================================

# --- JWT ---
# Clave secreta larga y aleatoria (mínimo 32 caracteres).
# Usa una DIFERENTE en desarrollo y en producción.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_de_al_menos_32_caracteres
# Duración de la sesión en milisegundos (28800000 = 8 horas).
JWT_EXPIRATION=28800000

# --- Administrador inicial (solo se crea si no existe ningún ADMIN) ---
# Contraseña: de 4 a 12 caracteres (regla del sistema).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PHONE=3000000000
INITIAL_ADMIN_PASSWORD=Cambia123

# --- Solo para el perfil prod (en dev la conexión está en application-dev.yml) ---
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://localhost:5432/mantas_guajiras_db
# DB_USERNAME=mantas_app
# DB_PASSWORD=
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com
