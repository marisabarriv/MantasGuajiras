# =========================================================
# Servidor web de Mantas Guajiras (Caddy).
# SITE_ADDRESS (deploy/.env):
#   - Un dominio, p. ej. ventas.mantasguajiras.com → certificado HTTPS
#     gratuito y automático (Let's Encrypt), renovado solo.
#   - localhost → certificado local (pruebas en el mismo equipo).
# =========================================================
{$SITE_ADDRESS} {
	encode zstd gzip

	# Cabeceras de seguridad. La política de contenido (CSP) ya va dentro
	# de index.html; aquí se agrega lo que una etiqueta <meta> no puede.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# Backend (mismo dominio: no hace falta CORS).
	@backend path /api/* /auth/* /users /users/* /actuator/health /actuator/info
	handle @backend {
		reverse_proxy backend:8080
	}

	# El resto de Actuator no se publica.
	handle /actuator/* {
		respond 404
	}

	# La app (React). Rutas desconocidas → index.html (la app decide).
	handle {
		root * /srv
		# Lo que debe revisarse en cada visita para recibir actualizaciones.
		@fresh path / /index.html /sw.js /manifest.webmanifest /offline.html
		header @fresh Cache-Control "no-cache"
		# Archivos con huella en el nombre: no cambian nunca.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
