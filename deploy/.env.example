# =========================================================
# Configuración de producción. Copiar a deploy/.env y completar.
# deploy/.env NUNCA se sube a git (está en .gitignore).
# Claves largas y al azar, por ejemplo: openssl rand -base64 36
# =========================================================

# Dirección de la app: tu dominio (HTTPS automático) o localhost (pruebas).
SITE_ADDRESS=ventas.ejemplo.com

# PostgreSQL: administrador (solo para las copias) y usuario de la app.
POSTGRES_PASSWORD=
DB_USERNAME=mantas_app
DB_PASSWORD=

# Sesiones: clave de 32+ caracteres; duración 12 h (la jornada).
JWT_SECRET=
JWT_EXPIRATION=43200000

# Administrador que se crea si no hay ninguno. Cambiar la contraseña
# en el primer ingreso (Mi perfil).
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=

# Copias: carpeta del servidor y segunda copia en OTRO disco o en una
# carpeta sincronizada con la nube.
BACKUP_DIR=./backups
BACKUP_COPY_TO=./backups-copia

# Zona horaria de la tienda.
TZ=America/Bogota
