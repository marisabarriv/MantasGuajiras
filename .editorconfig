# Formato común para todos los editores (VS Code, IntelliJ...).
# VS Code lo aplica con la extensión "EditorConfig for VS Code".
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[frontend/src/**.{js,jsx,css}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
